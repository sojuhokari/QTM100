# TWO-SAMPLE T-TEST
#
tapply(X = NSYR$bmi2, INDEX = NSYR$trauma2, FUN = mean, na.rm = T)
# Make two new variables containing the two sets of data
trauma_yes <- NSYR$bmi2[NSYR$trauma2 == "Yes"]
trauma_no <- NSYR$bmi2[NSYR$trauma2 == "No"]
